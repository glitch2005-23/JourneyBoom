# Mailchimp embedded-form action URL (public by design — NOT an API key).
# Find it in Mailchimp: Audience → Signup forms → Embedded forms → copy the <form action="..."> URL.
# Example: https://journeyboom.us21.list-manage.com/subscribe/post?u=abc123&id=def456
# Leave empty to use the mailto fallback provider.
NEXT_PUBLIC_MAILCHIMP_FORM_URL=
