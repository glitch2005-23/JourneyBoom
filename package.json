{
  "name": "journey-boom",
  "version": "1.0.0",
  "private": true,
  "description": "File-driven travel website — JSON content as CMS, Next.js static export.",
  "scripts": {
    "dev": "next dev",
    "predev": "npm run images",
    "prebuild": "npm run validate-content && npm run images",
    "build": "next build",
    "postbuild": "tsx scripts/fix-export-segments.ts",
    "start": "npx serve out",
    "validate-content": "tsx scripts/validate-content.ts",
    "images": "tsx scripts/optimize-images.ts",
    "brand": "tsx scripts/prepare-brand.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
